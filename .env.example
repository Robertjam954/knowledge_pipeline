# Copy to backend/.env and adjust. All vars use the KP_ prefix.

KP_VAULT_PATH=/Users/robertjames/loc/vault
KP_LMSTUDIO_BASE_URL=http://localhost:1234/v1
KP_CHAT_MODEL=google/gemma-3-12b
KP_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

# Optional: Claude for drafting/extraction (KP_LLM_PROVIDER=anthropic to enable)
KP_LLM_PROVIDER=lmstudio
KP_ANTHROPIC_API_KEY=
KP_ANTHROPIC_MODEL=claude-sonnet-5

# Publishing
KP_VERCEL_DEPLOY_HOOK_URL=
KP_MEDIUM_TOKEN=          # medium.com/@robertjam954 -> Settings -> Security and apps
KP_AUTO_GIT_PUBLISH=false
